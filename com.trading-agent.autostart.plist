<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-agent.autostart</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Replace YOUR_USERNAME with your actual Mac username -->
        <string>cd "/Users/YOUR_USERNAME/Documents/trading-agent" &amp;&amp; bash "▶️ הפעל סוכן.command" &gt;&gt; /tmp/trading-agent-autostart.log 2&gt;&amp;1</string>
    </array>

    <!-- Run every weekday (Sun-Thu in Israel = Mon-Fri US) at 16:00 IST -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Sunday -->
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <!-- Monday -->
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <!-- Tuesday -->
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <!-- Wednesday -->
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <!-- Thursday -->
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/trading-agent-autostart.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/trading-agent-autostart.log</string>
</dict>
</plist>
