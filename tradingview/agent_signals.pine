//@version=5
// Trading Agent Signals - Shows the agent's trades on TradingView charts
//
// Setup:
//   1. Run the dashboard: ./start.sh dashboard
//   2. Expose via ngrok: ngrok http 5555
//   3. Replace AGENT_URL below with your ngrok URL
//   4. Add this script to your TradingView chart

indicator("Trading Agent Signals", overlay=true, max_labels_count=500)

// ============================================================
// SETTINGS
// ============================================================
AGENT_URL = input.string("http://localhost:5555", "Agent Dashboard URL",
     tooltip="URL of your trading agent dashboard. Use ngrok URL for remote access.")

// ============================================================
// NOTE: TradingView Pine Script cannot make HTTP requests.
// This script works as a VISUAL TEMPLATE.
//
// To see real agent signals on TradingView, use one of these methods:
//
// Method 1: TradingView Alerts + Webhooks (Recommended)
//   - The agent sends webhooks TO TradingView
//   - Set up alerts that trigger on the agent's signals
//
// Method 2: Manual Pine Script with hardcoded signals
//   - The dashboard exports signals as Pine Script code
//   - Copy-paste the generated code into TradingView
//
// Method 3: Use the local Dashboard instead
//   - Open http://localhost:5555 in your browser
//   - Has TradingView-quality charts with real-time signals
// ============================================================

// Visual elements for when signals are manually added:

// Input for showing strategy zones
show_zones = input.bool(true, "Show Strategy Zones")
show_levels = input.bool(true, "Show Entry/SL/TP Levels")

// Example signal visualization (replace with actual data)
// These would be populated by the webhook integration

// Buy signal marker
plotshape(false, title="Buy Signal", style=shape.labelup,
     location=location.belowbar, color=color.new(color.green, 0),
     textcolor=color.white, size=size.small)

// Sell signal marker
plotshape(false, title="Sell Signal", style=shape.labeldown,
     location=location.abovebar, color=color.new(color.red, 0),
     textcolor=color.white, size=size.small)

// Strategy info table
var table infoTable = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 80), border_width=1,
     border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(infoTable, 0, 0, "Trading Agent", text_color=color.white,
         text_size=size.normal, text_halign=text.align_left)
    table.cell(infoTable, 1, 0, "📊", text_size=size.normal)

    table.cell(infoTable, 0, 1, "Status", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 1, "Connected", text_color=color.green, text_size=size.small)

    table.cell(infoTable, 0, 2, "Dashboard", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, AGENT_URL, text_color=color.blue, text_size=size.tiny)

    table.cell(infoTable, 0, 3, "─────", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, "─────", text_color=color.gray, text_size=size.tiny)

    table.cell(infoTable, 0, 4, "Tip", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 4, "Open Dashboard for", text_color=color.white, text_size=size.tiny)

    table.cell(infoTable, 0, 5, "", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 5, "real-time signals", text_color=color.white, text_size=size.tiny)

// ============================================================
// EMA lines (same as agent uses)
// ============================================================
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)

plot(ema9, "EMA 9", color=color.new(color.blue, 30), linewidth=2)
plot(ema21, "EMA 21", color=color.new(color.purple, 30), linewidth=2)

// VWAP
plot(ta.vwap, "VWAP", color=color.new(color.yellow, 40), linewidth=1, style=plot.style_circles)

// Bollinger Bands
[bbUpper, bbMid, bbLower] = ta.bb(close, 20, 2)
plot(bbUpper, "BB Upper", color=color.new(color.gray, 60), linewidth=1)
plot(bbLower, "BB Lower", color=color.new(color.gray, 60), linewidth=1)
fill(plot(bbUpper, display=display.none), plot(bbLower, display=display.none),
     color=color.new(color.gray, 92))

// RSI background shading
rsi = ta.rsi(close, 14)
bgcolor(rsi < 30 ? color.new(color.green, 92) : rsi > 70 ? color.new(color.red, 92) : na,
     title="RSI Zones")

// EMA crossover signals (same as agent's EMA strategy)
ema_cross_up = ta.crossover(ema9, ema21)
ema_cross_down = ta.crossunder(ema9, ema21)

plotshape(ema_cross_up and show_zones, title="EMA Cross Up",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 40), size=size.tiny)
plotshape(ema_cross_down and show_zones, title="EMA Cross Down",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 40), size=size.tiny)
